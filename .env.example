# Copy to .env and adjust as needed. All values have sensible defaults in
# app/core/config.py; nothing here is required to run.

# --- Server ---
EMPATHVOICE_HOST=127.0.0.1
EMPATHVOICE_PORT=8000

# --- Models ---
EMPATHVOICE_EMOTION_MODEL=SamLowe/roberta-base-go_emotions
EMPATHVOICE_VAD_MODEL=RobroKools/vad-bert
# Force a device, or leave unset for auto-detect (cuda if available, else cpu).
# EMPATHVOICE_DEVICE=cpu
# Max concurrent model inferences (shared model instance). 1 = serialize.
EMPATHVOICE_INFERENCE_CONCURRENCY=1

# --- Audio ---
EMPATHVOICE_AUDIO_DIR=audio_outputs
EMPATHVOICE_AUDIO_TTL_SECONDS=3600
EMPATHVOICE_DEFAULT_VOICE=en-IN-NeerjaNeural

# --- Limits ---
EMPATHVOICE_MAX_TEXT_CHARS=2000

# --- Logging ---
EMPATHVOICE_LOG_LEVEL=INFO
